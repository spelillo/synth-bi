# Server-side only (read by api/ Vercel functions) — never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
CRON_SECRET=

# The client-side Supabase URL + anon key are hardcoded at the top of auth.js,
# same as synth-sql — no bundler for the shell to inject them at build time.
# The anon key is meant to be public; point it at your own Supabase project
# for local development.
