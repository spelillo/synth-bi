{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/welcome",
      "destination": "/welcome.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/licenses",
      "destination": "/licenses.html"
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/welcome",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/data-retention",
      "schedule": "23 4 * * *"
    }
  ]
}
